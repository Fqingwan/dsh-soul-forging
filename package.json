{
  "name": "dsh-soul-forging",
  "version": "0.2.4",
  "description": "Separate Vessels, One Heart · 异体同心 —— 给 AI 的可迁移长期记忆与铸魂流程：markdown 记忆库 + 小脑检索 + 能长出来的性格。纯本地，不要服务器。",
  "license": "MIT",
  "type": "module",
  "main": "lib/plugin.js",
  "exports": {
    ".": "./lib/plugin.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "soul": "./bin/soul",
    "soul-boot": "./bin/soul-boot",
    "soul-sync": "./bin/sync",
    "soul-serve": "./bin/serve",
    "soul-recall": "./bin/brain",
    "soul-init": "./bin/init-home",
    "soul-forget": "./bin/brain-forget",
    "soul-compact": "./bin/compact",
    "soul-snapshot": "./bin/mem-snapshot",
    "soul-peer": "./bin/soul-peer",
    "soul-debug": "./bin/debug-archive",
    "soul-archive": "./bin/archive-log",
    "soul-sediment": "./bin/persona-sediment",
    "soul-review": "./bin/growth-review",
    "soul-debug-recall": "./bin/debug-recall",
    "soul-debug-detail": "./bin/summarize-debug",
    "soul-purge": "./bin/forget",
    "soul-thread": "./bin/live-thread",
    "soul-coalesce": "./bin/brain-coalesce",
    "soul-topic": "./bin/topic",
    "soul-diff": "./bin/soul-diff",
    "soul-boot-check": "./bin/soul-boot-check"
  },
  "files": [
    "lib",
    "bin",
    "brain/index.py",
    "brain/server.py",
    "brain/soul_lib.py",
    "brain/fix-live-summary.py",
    "memory",
    "docs",
    "soul.py",
    "cordis.patch.yml",
    "install.sh",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "scripts/smoke.sh"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "keywords": [
    "dsh",
    "plugin",
    "memory",
    "persona",
    "soul",
    "markdown",
    "llm",
    "agent"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fqingwan/dsh-soul-forging.git"
  },
  "homepage": "https://github.com/Fqingwan/dsh-soul-forging#readme",
  "bugs": {
    "url": "https://github.com/Fqingwan/dsh-soul-forging/issues"
  },
  "author": {
    "name": "晴晚",
    "url": "https://github.com/Fqingwan/dsh-soul-forging"
  },
  "scripts": {
    "test": "bash scripts/smoke.sh",
    "prepublishOnly": "bash scripts/smoke.sh"
  }
}