{
  "name": "dsh-memkit",
  "version": "0.1.0",
  "description": "可迁移的长期记忆套件：markdown 记忆库 + 小脑检索 + 铸魂流程。纯本地，不需要服务器。",
  "license": "MIT",
  "type": "module",
  "main": "lib/plugin.js",
  "exports": {
    ".": "./lib/plugin.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "memkit-boot": "./bin/kit-boot",
    "memkit": "./bin/kit-memory",
    "memkit-sync": "./bin/sync",
    "memkit-serve": "./bin/serve",
    "memkit-recall": "./bin/brain"
  },
  "files": [
    "lib",
    "bin",
    "brain/index.py",
    "brain/server.py",
    "memory",
    "docs",
    "kit.py",
    "cordis.patch.yml",
    "install.sh",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "keywords": ["dsh", "dsh-plugin", "memory", "markdown", "llm", "agent"]
}
