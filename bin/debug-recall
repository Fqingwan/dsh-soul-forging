#!/usr/bin/env bash
# 查调试旧账：debug-recall "报错关键词"
# 遇到报错先查这里，别重新走一遍弯路。
source "$(dirname "$0")/_common.sh"
Q="${1:-}"
IDX="$DOCS_DIR/debug/INDEX.md"
[ -z "$Q" ] && { echo "用法：debug-recall \"关键词\""; echo "      debug-recall --list"; exit 1; }
[ ! -f "$IDX" ] && { echo "还没有调试档案（$IDX 不存在）"; exit 0; }
if [ "$Q" = "--list" ]; then grep -E '^\- \[' "$IDX" | head -50; exit 0; fi
grep -i -n -- "$Q" "$IDX" | head -20 || echo "（没查到同类问题——那这就是新问题）"
