#!/usr/bin/env bash
# 记忆链路一键同步（纯本地）：
#   补摘要 → 时间线瘦身 → 建索引 → 通知服务 → 体检 →（可选）备份
# 一步失败不挡后面——每步都记进 cron-run.log，失败的另外写 alarm.log。
_SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
source "$(dirname "$_SELF")/_common.sh"
LOCK=/tmp/soul-sync.lock
exec 9>"$LOCK"
if ! flock -n 9; then echo "同步已在运行，跳过"; exit 0; fi

R() { bash "$BIN_DIR/runlog" "$@"; }; rc=0
bash "$BIN_DIR/runlog" "live-summary" -- "$PY" "$MEMKIT_ROOT/brain/fix-live-summary.py"                  || rc=$((rc+1))
bash "$BIN_DIR/runlog" "archive-log" -- bash "$BIN_DIR/archive-log"                                  || rc=$((rc+2))
bash "$BIN_DIR/runlog" "index" -- "$PY" "$MEMKIT_ROOT/brain/index.py"                             || rc=$((rc+4))
bash "$BIN_DIR/runlog" "reload" -- bash -c "curl -s -m 5 -X POST $BRAIN_URL/reload >/dev/null" || rc=$((rc+8))
bash "$BIN_DIR/runlog" "check" -- bash "$BIN_DIR/soul" check                             || rc=$((rc+16))
[ -n "${SOUL_BACKUP_CMD:-}" ] && { bash "$BIN_DIR/runlog" "backup" -- bash -c "$SOUL_BACKUP_CMD" || rc=$((rc+32)); }

if [ $rc -eq 0 ]; then echo "sync ok"; else echo "sync 有失败项 rc=$rc（看 $BRAIN_DIR/alarm.log）"; fi
exit 0
