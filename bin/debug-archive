#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""调试档案：扫 docs/debug/ 下的文件，检查有没有登记进 INDEX.md。

不登记等于没写——下次搜不到。
另外可选打包（原文可以放云端，本地只留索引）。

用法: bin/debug-archive          # 检查漏登记的
      bin/debug-archive --tar    # 顺便打成一个包
"""
import os, subprocess, sys, tarfile, time
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "brain"))
from memkit_lib import DOCS

DBG = os.path.join(DOCS, "debug")
IDX = os.path.join(DBG, "INDEX.md")

def main():
    if not os.path.isdir(DBG):
        print("没有 docs/debug"); return 0
    idx = open(IDX, encoding="utf-8").read() if os.path.exists(IDX) else ""
    files = [f for f in sorted(os.listdir(DBG)) if f.endswith(".md") and f not in ("INDEX.md", "README.md")]
    if not files:
        print("还没有档案"); return 0
    missing = [f for f in files if f not in idx]
    print(f"档案 {len(files)} 份，未登记 {len(missing)} 份")
    for f in missing:
        print(f"\n  {f}")
        out = subprocess.run([sys.executable, os.path.join(os.path.dirname(os.path.abspath(__file__)), "summarize-debug"),
                              os.path.join(DBG, f)], capture_output=True, text=True).stdout.strip()
        print("  建议加这一行到 INDEX.md：")
        print("  " + (out or "（没提取到，手写吧）"))
    if "--tar" in sys.argv:
        out = os.path.join(DBG, f"debug-{time.strftime('%Y%m%d')}.tgz")
        with tarfile.open(out, "w:gz") as t:
            for f in files: t.add(os.path.join(DBG, f), arcname=f)
        print(f"\n打包：{out}")
    return 0

if __name__ == "__main__":
    sys.exit(main())
