#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""遗忘：按强度衰减把"几乎想不起来"的条目标记为遗忘。

**不删原文。** 只在 state.json 里记一笔，索引时跳过。
想找回：brain-forget --restore <id>。

强度 = salience 基数 × 时间衰减 + 被想起的加成。
阈值默认 0.12，低于它就是"模糊到想不起来"。

用法: brain-forget            # 只报告
      brain-forget --apply    # 真的标记
      brain-forget --restore <id>
      brain-forget --list
"""
import json, math, os, sys
from datetime import datetime, timezone
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "brain"))
from memkit_lib import load_state, save_state, BRAIN

BASE = {1: 1.0, 2: 0.75, 3: 0.5}
HALFLIFE = {1: 720, 2: 180, 3: 45}
THRESHOLD = float(os.environ.get("FORGET_THRESHOLD") or 0.12)

def age_days(d):
    if not d: return None
    for fmt in ("%Y-%m-%d", "%Y-%m-%d %H:%M"):
        try:
            dd = datetime.strptime(d[:16] if fmt.endswith("%H:%M") else d[:10], fmt).replace(tzinfo=timezone.utc)
            return max(0.0, (datetime.now(timezone.utc) - dd).total_seconds() / 86400)
        except Exception: continue
    return None

def main():
    st = load_state()
    if "--list" in sys.argv:
        for k, v in st["forgotten"].items():
            print(f"{k}  {v.get('at','')}  {v.get('why','')}")
        print(f"共 {len(st['forgotten'])} 条"); return 0
    if "--restore" in sys.argv:
        i = sys.argv.index("--restore")
        rid = sys.argv[i+1] if len(sys.argv) > i+1 else ""
        if rid in st["forgotten"]:
            del st["forgotten"][rid]
            st.setdefault("pinned", {})[rid] = {"at": datetime.now(timezone.utc).strftime("%Y-%m-%d")}
            save_state(st)
            print(f"已找回 {rid}（并钉住，不会再淡掉）")
            return 0
        print("没这条"); return 1

    try:
        entries = json.load(open(os.path.join(BRAIN, "entries.json"), encoding="utf-8"))
    except Exception:
        print("还没有索引，先跑 kit-memory index"); return 1

    hit = []
    for e in entries:
        sal = int(e.get("salience") or 2)
        age = age_days(e.get("date") or "")
        decay = math.exp(-age / HALFLIFE.get(sal, 180)) if age is not None else 1.0
        hits = st["touch"].get(e["id"], 0)
        stv = max(0.0, min(1.0, BASE.get(sal, .75) * decay + min(.35, hits*.05)))
        if stv < THRESHOLD:
            hit.append((stv, e["id"], e.get("section") or e.get("title")))
    if "--apply" in sys.argv:
        for stv, rid, _ in hit:
            st["forgotten"][rid] = {"at": datetime.now(timezone.utc).strftime("%Y-%m-%d"), "why": f"强度{stv:.2f}"}
        save_state(st); print(f"已标记遗忘 {len(hit)} 条（原文没删，可用 --restore 找回）")
    else:
        print(f"该遗忘了 {len(hit)} 条（加 --apply 才真标记）")
    for stv, rid, sec in hit[:15]:
        print(f"  {stv:.2f}  {sec[:40] if sec else rid}")
    return 0

if __name__ == "__main__":
    sys.exit(main())
